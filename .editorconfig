root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{toml,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{proto,wit}]
indent_style = space
indent_size = 2
