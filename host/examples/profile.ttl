# A small Solid profile. Parse it against the address it would be served from:
#   cargo run --example parse -- --base https://pod.example/profile/card host/examples/profile.ttl

@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<#me> a foaf:Person ;
	foaf:name "Alice"@en, "Alicja"@pl ;
	foaf:knows [ a foaf:Person ; foaf:name "Bob" ] ;
	schema:knowsLanguage ( "fi" "en" "pl" ) .

# An RDF 1.2 triple term: a claim about what Alice says of herself.
<#claim> rdf:reifies <<( <#me> schema:birthDate "1990-01-01" )>> ;
	schema:author <#me> .
